# Palette commands must begin with an underscore in Sioyek.
# The light custom palette stays close to normal rendering, while this option
# redraws raster images without the color transform.
new_macro _warm_filter setconfig_custom_background_color('0.969 0.945 0.890');setconfig_custom_text_color('0.125 0.106 0.078');setconfig_custom_color_contrast('1.0');setconfig_preserve_image_colors_in_dark_mode('1');toggle_dark_mode;toggle_custom_color

# Force normal PDF colors regardless of the currently active color mode.
new_macro _warm_filter_off toggle_custom_color;toggle_dark_mode;toggle_dark_mode
